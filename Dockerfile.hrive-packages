FROM node:22-bookworm-slim
WORKDIR /app
ENV OUTBORN_REGISTRY_URL=https://registry.outborn.co

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' '{"private":true,"workspaces":["packages/hrive-sdk","packages/hrive-mcp"],"devDependencies":{"typescript":"5.9.2"}}' > package.json

COPY packages/hrive-sdk/package.json packages/hrive-sdk/package.json
COPY packages/hrive-mcp/package.json packages/hrive-mcp/package.json
RUN npm install --include=dev --ignore-scripts --no-audit --no-fund

COPY packages/hrive-sdk ./packages/hrive-sdk
COPY packages/hrive-mcp ./packages/hrive-mcp
COPY scripts/hrive-package-overlay.mjs ./scripts/hrive-package-overlay.mjs

RUN npm run build -w @outborn/hrive-sdk \
  && npm run build -w @outborn/hrive-mcp

ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "scripts/hrive-package-overlay.mjs"]
